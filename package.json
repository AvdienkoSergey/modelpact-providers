{
  "name": "modelpact-providers",
  "version": "1.1.0",
  "description": "Language-model backends written against the modelpact contract — a daemon, the OpenAI dialect, the browser's own model, one in the tab, each green on the contract suite",
  "keywords": [
    "llm",
    "modelpact",
    "typescript",
    "ollama",
    "openai",
    "openai-compatible",
    "prompt-api",
    "webgpu",
    "on-device",
    "adapter",
    "contract-testing"
  ],
  "license": "MIT",
  "author": "Sergey Avdienko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvdienkoSergey/modelpact-providers.git"
  },
  "homepage": "https://github.com/AvdienkoSergey/modelpact-providers#readme",
  "bugs": {
    "url": "https://github.com/AvdienkoSergey/modelpact-providers/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "import": "./dist/webgpu.js"
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "demo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "patch-package",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo": "npm --prefix demo run dev",
    "demo:check": "npm --prefix demo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.patched.json && tsc -p e2e --noEmit",
    "check:surface": "npm run build && tsc -p tsconfig.surface.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "modelpact": ">=2.2",
    "@mlc-ai/web-llm": ">=0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@mlc-ai/web-llm": "^0.2.84",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "modelpact": "^2.2.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "@mlc-ai/web-llm": {
      "optional": true
    }
  }
}
